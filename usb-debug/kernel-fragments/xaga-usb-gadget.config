# ============================================================================
# xaga (Redmi Note 11T Pro / MT6895) — USB gadget 调试支持
# ============================================================================
# 用途：让手机作为 USB 设备被 PC 识别 —— 串口控制台（CDC-ACM → /dev/ttyGS0）
#       以及可选的 USB 网卡（RNDIS / NCM / EEM），不需要 WiFi/SSH 也能连上。
#
# 【为什么必须写进这个 fragment】
# 上游 arch/arm64/configs/defconfig 里 USB gadget 相关全是 =m：
#     CONFIG_USB_LIBCOMPOSITE=m   CONFIG_USB_CONFIGFS=m
#     CONFIG_USB_F_ACM=m          CONFIG_USB_U_SERIAL=m   ...
# xaga.config 只把 CONFIG_USB_GADGET 置了 y，还把 legacy g_serial 显式关掉：
#     # CONFIG_USB_G_SERIAL is not set
# 而本构建流程只执行 `make Image`，从不 `make modules` / 不装 /lib/modules，
# 所以所有 =m 的东西**等于没编**：插上 PC 后内核里既没有 configfs-gadget，
# 也没有任何 gadget function，PC 侧什么都看不到（这是「USB 连不上」的根因）。
# 因此这里全部用 =y 强制内建，一个模块都不依赖。
#
# 实测证据（从刷进去的 boot.img 里抠出的 .config）：
#     CONFIG_USB_GADGET=y
#     CONFIG_USB_LIBCOMPOSITE=m      ← 模块，没编
#     CONFIG_USB_CONFIGFS=m          ← 模块，没编
#     CONFIG_USB_F_ACM=m             ← 模块，没编
#     # CONFIG_USB_G_SERIAL is not set
#     CONFIG_TYPEC_TCPCI_MT6375=y    （TCPM 角色切换正常，硬件侧没问题）
#
# 注：DRD 控制器 mtu3、Type-C/TCPM 在 xaga 上都是好的（上游 commit 675f8d9f
#     "bring up USB peripheral and guarded OTG host support"），缺的只是
#     gadget function 这一层。userspace 侧的 configfs 绑定见同目录脚本。
# ============================================================================

# ---- gadget 核心：必须内建，不能是 m ----
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y

# ---- 复合功能（function）驱动 ----
CONFIG_USB_U_SERIAL=y
CONFIG_USB_U_ETHER=y
CONFIG_USB_F_ACM=y
CONFIG_USB_F_SERIAL=y
CONFIG_USB_F_OBEX=y
CONFIG_USB_F_NCM=y
CONFIG_USB_F_ECM=y
CONFIG_USB_F_EEM=y
CONFIG_USB_F_RNDIS=y
CONFIG_USB_F_SUBSET=y
CONFIG_USB_F_MASS_STORAGE=y
CONFIG_USB_F_FS=y

# ---- configfs 里可选的功能开关 ----
CONFIG_USB_CONFIGFS_ACM=y        # 串口控制台（Windows 免驱，认成 COM 口）
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y      # Windows 免驱的 USB 网卡
CONFIG_USB_CONFIGFS_EEM=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y   # 可选：把 rootfs 当 U 盘挂到 PC 上救砖
CONFIG_USB_CONFIGFS_F_FS=y

# ---- 保留上游「不开 legacy g_serial」的决定 ----
# legacy g_serial 一旦内建就会在 probe 时抢占 UDC，configfs 就无法再绑定了
# （一个 UDC 同时只能有一个 gadget driver），两者只能二选一。
# 我们走 configfs（可同时提供 ACM 串口 + USB 网卡），所以这里显式关掉。
# CONFIG_USB_G_SERIAL is not set

# ---- host 侧（可选）：USB-OTG 接 CH340/CP210x 等调试串口线时需要 ----
# 同样必须 =y，=m 等于没编。
CONFIG_USB_ACM=y
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_SERIAL_CH341=y
CONFIG_USB_SERIAL_CP210X=y
CONFIG_USB_SERIAL_FTDI_SIO=y
CONFIG_USB_SERIAL_PL2303=y
